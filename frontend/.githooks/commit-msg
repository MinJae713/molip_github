#!/bin/sh

echo "--- Commit Hook Running ---"
MSG_FILE="$1"

# 고정 prefix
PREFIX="S14P11A309-"

# 커밋 메시지 전체 읽기
FULL_MSG=$(cat "$MSG_FILE")

# 1. 단어 및 이모지 변환 (단어 뒤의 콜론 등은 유지하면서 단어 자체만 변환)
# sed의 -e 옵션을 사용하여 여러 규칙을 순차적으로 적용합니다.
CONVERTED_MSG=$(echo "$FULL_MSG" | sed \
  -e 's/chore/💫chore/g' \
  -e 's/feat/✨feat/g' \
  -e 's/fix/⛏fix/g' \
  -e 's/refactor/💡refactor/g' \
  -e 's/style/🎨style/g' \
  -e 's/design/💄design/g' \
  -e 's/docs/📝docs/g' \
  -e 's/test/✅test/g' \
  -e 's/update/⚡update/g' \
  -e 's/remove/🔥remove/g' \
  -e 's/in progress/🚧in progress/g' \
  -e 's/HOTFIX/🚑HOTFIX/g' \
  -e 's/add dependency/➕add dependency/g' \
  -e 's/typo fix/✏typo fix/g')

# 변환된 메시지의 첫 줄 추출
FIRST_LINE=$(echo "$CONVERTED_MSG" | head -n 1)

# merge / revert / squash / fixup 커밋은 건드리지 않음
case "$FIRST_LINE" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

# 2. 이미 prefix가 붙어 있는지 확인
case "$FIRST_LINE" in
  "$PREFIX"*)
    # 이미 있으면 변환된 내용만 업데이트하고 종료
    echo "$CONVERTED_MSG" > "$MSG_FILE"
    exit 0
    ;;
esac

# 3. prefix 추가 및 최종 저장
{
  printf "%s%s\n" "$PREFIX" "$FIRST_LINE"
  echo "$CONVERTED_MSG" | tail -n +2
} > "$MSG_FILE.tmp" && mv "$MSG_FILE.tmp" "$MSG_FILE"

exit 0
