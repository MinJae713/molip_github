pipeline {
    agent any

    environment {
        // 도커 허브 자격 증명 ID
        DOCKER_CREDS = 'docker-hub-creds'
        DOCKER_IMAGE = 'pneum44/molip-api'
        DOCKER_TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                // GitLab master 브랜치 코드 가져오기 (전체 프로젝트가 내려받아짐)
                checkout scm
            }
        }

        stage('Backend Build & Push') {
            steps {
                // backend 폴더 안으로 진입하여 작업 수행
                dir('backend') {
                    script {
                        // 1. mvnw 파일에 실행 권한 부여 (Git에서 권한이 누락될 경우를 대비)
                        sh "chmod +x mvnw"

                        // 2. Maven Wrapper로 빌드
                        sh "./mvnw clean package -DskipTests"

                        // 3. 도커 로그인 및 빌드/푸시
                        docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_CREDS}") {
                            // backend 폴더 내의 Dockerfile을 사용하여 빌드
                            sh "docker build --platform linux/amd64 -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                            sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                        }
                    }
                }
            }
        }


        stage('Deploy') {
            steps {
                script {
                    // 도커 허브 자격 증명을 사용하여 로그인 상태에서 pull과 up을 실행합니다.
                    docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_CREDS}") {
                        sh "docker compose -f /home/ubuntu/docker-compose.yml pull molip-api"
                        sh "docker compose -f /home/ubuntu/docker-compose.yml up -d molip-api"
                    }
                }
            }
        }


        stage('Cleanup') {
            steps {
                sh "docker image prune -f"
            }
        }
    }

    post {
        success {
            echo "🎉 [성공] Backend 배포가 완료되었습니다!"
        }
        failure {
            echo "❌ [실패] Backend 빌드 중 에러가 발생했습니다. 로그를 확인하세요."
        }
    }
}
