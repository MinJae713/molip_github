root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
# google-java-format은 2칸 들여쓰기를 강제합니다.
indent_size = 2
continuation_indent_size = 4

# 인텔리제이가 멋대로 import를 *로 바꾸지 않도록 설정
ij_java_names_count_to_use_import_on_demand = 999
ij_java_class_count_to_use_import_on_demand = 999

# 기타 파일들
[*.{xml,json,yml,yaml}]
indent_size = 2