<?xml version="1.0"?>
<ruleset name="Custom Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">

  <description>Custom ruleset for Molip Project</description>

  <rule ref="rulesets/java/quickstart.xml">
    <exclude name="LambdaCanBeMethodReference"/>
    <exclude name="UseUtilityClass"/>
    <exclude name="ClassWithOnlyPrivateConstructorsShouldBeFinal"/>
    <exclude name="ShortVariable"/>
    <exclude name="OnlyOneReturn"/>
    <exclude name="AvoidElseIfStatements"/>
    <exclude name="GuardLogStatement"/>
  </rule>
</ruleset>
